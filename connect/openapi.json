            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "name": "period_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of academic periods",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcademicPeriodList"
                }
              }
            }
          }
        }
      }
    },
    "/courses": {
