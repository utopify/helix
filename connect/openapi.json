        ],
        "summary": "List academic programs",
        "parameters": [
          {
            "name": "degree_level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "program_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of programs",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProgramList"
                }
              }
            }
          }
        }
      }
    },
    "/financial-aid-awards": {
      "get": {
        "operationId": "listFinAidAwards",
        "tags": [
          "Financial Aid"
        ],
        "summary": "List financial aid awards",
        "parameters": [
          {
            "name": "academic_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "award_type",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "award_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "fund_source",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/updatedSince"
          }
        ],
        "responses": {
          "200": {
            "description": "List of financial aid awards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinAidAwardList"
                }
              }
            }
          }
        }
      }
    },
    "/degrees": {
      "get": {
        "operationId": "listDegrees",
        "tags": [
          "Outcomes"
        ],
        "summary": "List conferred degrees",
        "parameters": [
          {
            "name": "conferral_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "degree_level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "program_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/updatedSince"
          }
        ],
        "responses": {
          "200": {
            "description": "List of degrees",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DegreeList"
                }
              }
            }
          }
        }
      }
    },
    "/$export": {
      "get": {
        "operationId": "bulkExport",
        "tags": [
          "Bulk Export"
        ],
        "summary": "Bulk export resources for data lake ingestion",
        "description": "Initiates an asynchronous bulk export of one or more resource types. Returns NDJSON (newline-delimited JSON) files. Async bulk export operation.\n\nThe server returns a 202 Accepted with a Content-Location header pointing to a status endpoint. Poll the status endpoint until the export is complete, then download the resulting NDJSON files.",
        "parameters": [
          {
            "name": "_type",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Comma-separated list of resource types to export (e.g., 'Student,Enrollment'). If omitted, all supported resources are exported.",
            "example": "Student,Enrollment,AcademicPeriod"
          },
          {
            "name": "_since",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "date-time"
            },
            "description": "Only include resources updated after this timestamp. Enables incremental exports."
          },
          {
            "name": "_outputFormat",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "ndjson",
                "parquet"
              ],
              "default": "ndjson"
            },
            "description": "Output format. NDJSON is required for conformance. Parquet is optional but recommended for lake ingestion."
          }
        ],
        "responses": {
          "202": {
            "description": "Export initiated. Poll the Content-Location URL for status.",
            "headers": {
              "Content-Location": {
                "schema": {
                  "type": "string",
                  "format": "uri"
                },
                "description": "URL to poll for export status"
              }
            }
          },
          "429": {
            "description": "Too many concurrent exports. Retry after the indicated delay."
          }
        }
      }
    },
    "/$export-status/{export_id}": {
      "get": {
        "operationId": "getExportStatus",
        "tags": [
          "Bulk Export"
        ],
        "summary": "Check bulk export status",
        "parameters": [
          {
            "name": "export_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Export complete. Response includes download URLs for each resource type.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ExportResult"
                }
              }
            }
          },
          "202": {
            "description": "Export still in progress. Retry after the indicated delay."
          }
        }
      }
    },
    "/validate": {
      "post": {
        "operationId": "validateResource",
        "tags": [
          "Validation"
        ],
        "summary": "Validate a resource against HELIX Core schemas",
        "description": "Submit any HELIX resource payload and receive validation results against the corresponding JSON Schema and terminology bindings.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "resource_type",
                  "resource"
                ],
                "properties": {
                  "resource_type": {
                    "type": "string",
                    "enum": [
                      "Student",
                      "Enrollment",
                      "AcademicPeriod",
                      "Course",
                      "CourseSection",
                      "Program",
                      "FinAidAward",
                      "Degree",
                      "Institution"
                    ],
                    "description": "The HELIX resource type to validate against"
                  },
                  "resource": {
                    "type": "object",
                    "description": "The resource payload to validate"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation results",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationResult"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "parameters": {
      "pageSize": {
        "name": "page_size",
        "in": "query",
        "schema": {
          "type": "integer",
          "default": 100,
          "minimum": 1,
          "maximum": 1000
        },
        "description": "Number of resources per page"
      },
      "pageToken": {
        "name": "page_token",
        "in": "query",
        "schema": {
          "type": "string"
        },
        "description": "Opaque token for the next page of results"
      },
      "updatedSince": {
        "name": "updated_since",
        "in": "query",
        "schema": {
          "type": "string",
          "format": "date-time"
        },
        "description": "Only return resources updated after this timestamp (for incremental sync)"
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Authentication required. Provide a valid OAuth2 token or API key."
      },
      "Forbidden": {
        "description": "Insufficient permissions. The requested resource or data classification level is not authorized for this client."
      },
      "NotFound": {
        "description": "Resource not found for the given HELIX ID."
      }
    },
    "schemas": {
      "ServerMetadata": {
        "type": "object",
        "properties": {
          "helix_version": {
            "type": "string",
            "example": "0.1",
            "description": "HELIX Core spec version this server conforms to"
          },
          "conformance_level": {
            "type": "string",
            "enum": [
              "explorer",
              "aligned",
              "governed",
              "contributor",
              "champion"
            ]
          },
          "institution": {
            "type": "string",
            "description": "Institution name"
          },
          "institution_helix_id": {
            "type": "string",
            "format": "uuid"
          },
          "supported_resources": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "example": [
              "Student",
              "Enrollment",
              "AcademicPeriod",
              "Course",
              "CourseSection",
              "Program",
              "FinAidAward",
              "Degree"
            ]
          },
          "supported_operations": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "search",
                "export",
                "validate",
                "write"
              ]
            },
            "description": "Operations this server supports. 'read' and 'search' are required. 'export' and 'validate' are recommended. 'write' is optional."
          },
          "source_system": {
            "type": "string",
            "description": "Underlying ERP (e.g., 'banner', 'peoplesoft', 'workday')"
          },
          "bulk_export_formats": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "ndjson",
                "parquet"
              ]
            },
            "description": "Supported bulk export formats"
          }
        }
      },
      "Student": {
        "$ref": "https://helixedu.org/core/resources/student.json"
      },
      "StudentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Student"
            }
          },
          "total_count": {
            "type": "integer"
          },
          "page_token": {
            "type": "string",
            "description": "Token for the next page, null if no more results"
          }
        }
      },
      "EnrollmentList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "https://helixedu.org/core/resources/enrollment.json"
            }
          },
          "total_count": {
            "type": "integer"
          },
          "page_token": {
            "type": "string"
          }
        }
      },
      "AcademicPeriodList": {
        "type": "object",
        "properties": {
          "data": {
            "type": "array",
            "items": {
              "$ref": "https://helixedu.org/core/resources/academic_period.json"
            }
          },
          "total_count": {
            "type": "integer"
          },
          "page_token": {
            "type": "string"
          }
        }
      },
