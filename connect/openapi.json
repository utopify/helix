{
  "openapi": "3.1.0",
  "info": {
    "title": "HELIX Connect API",
    "description": "OpenAPI specification for a HELIX-conformant server. Defines the REST endpoints that any institution can implement to expose their data in HELIX Core resource format, regardless of the underlying ERP system.\n\nA conformant server exposes read endpoints for HELIX Core resources and a bulk export endpoint for data lake ingestion. Write endpoints are optional and intended for institutions that want to accept inbound data (e.g., from transfer partners or cross-institutional data sharing).",
    "version": "0.1.0",
    "license": {
      "name": "Apache 2.0",
      "url": "https://www.apache.org/licenses/LICENSE-2.0"
    },
    "contact": {
      "name": "HELIX Open Framework",
      "url": "https://github.com/utopify/helix"
    }
  },
  "servers": [
    {
      "url": "https://{institution}.edu/helix/v1",
      "description": "Institutional HELIX Connect server",
      "variables": {
        "institution": {
          "default": "demo",
          "description": "Institution's domain prefix"
        }
      }
    }
  ],
  "security": [
    {
      "oauth2": []
    },
    {
      "apiKey": []
    }
  ],
  "tags": [
    {
      "name": "Students",
      "description": "Student identity resources"
    },
    {
      "name": "Enrollment",
      "description": "Course registration and enrollment resources"
    },
    {
      "name": "Academic Structure",
      "description": "Courses, sections, programs, and periods"
    },
    {
      "name": "Financial Aid",
      "description": "Financial aid award resources"
    },
    {
      "name": "Outcomes",
      "description": "Degrees, credentials, and completion resources"
    },
    {
      "name": "Bulk Export",
      "description": "Bulk data export for lake ingestion"
    },
    {
      "name": "Metadata",
      "description": "Server capability and conformance information"
    },
    {
      "name": "Validation",
      "description": "Resource validation endpoints"
    }
  ],
  "paths": {
    "/metadata": {
      "get": {
        "operationId": "getServerMetadata",
        "tags": [
          "Metadata"
        ],
        "summary": "Server capability statement",
        "description": "Returns the server's HELIX conformance level, supported resources, supported HELIX Core version, and available operations. Describes the server's supported resources, operations, and conformance level.",
        "responses": {
          "200": {
            "description": "Server metadata",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerMetadata"
                }
              }
            }
          }
        }
      }
    },
    "/students": {
      "get": {
        "operationId": "listStudents",
        "tags": [
          "Students"
        ],
        "summary": "List or search students",
        "description": "Returns a paginated list of Student resources. Supports filtering by status, institution, and identifiers.",
        "parameters": [
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/updatedSince"
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "prospective",
                "applicant",
                "admitted",
                "enrolled",
                "leave_of_absence",
                "withdrawn",
                "graduated",
                "deceased"
              ]
            },
            "description": "Filter by student lifecycle status"
          },
          {
            "name": "identifier",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Search by identifier value (e.g., student ID, banner PIDM)"
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of students",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StudentList"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/students/{helix_id}": {
      "get": {
        "operationId": "getStudent",
        "tags": [
          "Students"
        ],
        "summary": "Get a single student",
        "description": "Returns the Student resource for the given HELIX ID.",
        "parameters": [
          {
            "name": "helix_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Student resource",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Student"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/students/{helix_id}/enrollments": {
      "get": {
        "operationId": "getStudentEnrollments",
        "tags": [
          "Students",
          "Enrollment"
        ],
        "summary": "Get enrollments for a student",
        "description": "Returns all Enrollment resources for the given student. Supports filtering by academic period and status.",
        "parameters": [
          {
            "name": "helix_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "academic_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by academic period HELIX ID"
          },
          {
            "name": "enrollment_status",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by enrollment status"
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of enrollments for the student",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentList"
                }
              }
            }
          }
        }
      }
    },
    "/students/{helix_id}/financial-aid": {
      "get": {
        "operationId": "getStudentFinancialAid",
        "tags": [
          "Students",
          "Financial Aid"
        ],
        "summary": "Get financial aid awards for a student",
        "parameters": [
          {
            "name": "helix_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "academic_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "award_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of financial aid awards",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FinAidAwardList"
                }
              }
            }
          }
        }
      }
    },
    "/students/{helix_id}/degrees": {
      "get": {
        "operationId": "getStudentDegrees",
        "tags": [
          "Students",
          "Outcomes"
        ],
        "summary": "Get degrees conferred to a student",
        "parameters": [
          {
            "name": "helix_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of degrees",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DegreeList"
                }
              }
            }
          }
        }
      }
    },
    "/enrollments": {
      "get": {
        "operationId": "listEnrollments",
        "tags": [
          "Enrollment"
        ],
        "summary": "List or search enrollments",
        "parameters": [
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          },
          {
            "$ref": "#/components/parameters/updatedSince"
          },
          {
            "name": "academic_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "enrollment_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "course_section_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Paginated list of enrollments",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentList"
                }
              }
            }
          }
        }
      }
    },
    "/academic-periods": {
