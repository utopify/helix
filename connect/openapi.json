            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "Filter by subject/department code"
          },
          {
            "name": "level",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of courses",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseList"
                }
              }
            }
          }
        }
      }
    },
    "/course-sections": {
      "get": {
        "operationId": "listCourseSections",
        "tags": [
          "Academic Structure"
        ],
        "summary": "List course sections",
        "parameters": [
          {
            "name": "academic_period_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "course_ref",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "delivery_mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "section_status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "$ref": "#/components/parameters/pageSize"
          },
          {
            "$ref": "#/components/parameters/pageToken"
          }
        ],
        "responses": {
          "200": {
            "description": "List of course sections",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CourseSectionList"
                }
              }
            }
          }
        }
      }
    },
    "/programs": {
      "get": {
