@prefix helix: <https://helixedu.org/ontology#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://helixedu.org/ontology> a owl:Ontology ;
  rdfs:label "HELIX Higher Education Ontology" ; owl:versionInfo "0.10.0" .

helix:AcademicStructureDomain a skos:Concept ; skos:prefLabel "Academic Structure" .
helix:AdvancementDomain a skos:Concept ; skos:prefLabel "Advancement" .
helix:EnrollmentRegistrationDomain a skos:Concept ; skos:prefLabel "Enrollment & Registration" .
helix:FinancialAidDomain a skos:Concept ; skos:prefLabel "Financial Aid" .
helix:FinancialOperationsDomain a skos:Concept ; skos:prefLabel "Financial Operations" .
helix:HumanResourcesDomain a skos:Concept ; skos:prefLabel "Human Resources" .
helix:IdentityDomain a skos:Concept ; skos:prefLabel "Identity" .
helix:OutcomesDomain a skos:Concept ; skos:prefLabel "Outcomes" .
helix:StudentServicesDomain a skos:Concept ; skos:prefLabel "Student Services" .

helix:AbsenceRecord a owl:Class ; rdfs:label "AbsenceRecord" ;
  rdfs:comment "An absence / leave record, vacation, sick, FMLA, sabbatical, etc., with balances and FMLA tracking. FMLA medical certification stored separately with restricted access." ;
  helix:classification "confidential" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:AcademicOrg a owl:Class ; rdfs:label "AcademicOrg" ;
  rdfs:comment "An academic organizational unit within an institution, college, school, division, department, or program area. Forms a hierarchy (university → college → department)." ;
  helix:classification "internal" ;
  helix:inDomain helix:AcademicStructureDomain .
helix:AcademicPeriod a owl:Class ; rdfs:label "AcademicPeriod" ;
  rdfs:comment "A defined period of academic activity (term, semester, quarter, session)." ;
  helix:classification "public" ;
  helix:inDomain helix:AcademicStructureDomain .
helix:AcademicTermRecord a owl:Class ; rdfs:label "AcademicTermRecord" ;
  rdfs:comment "A student's academic summary for a single academic period: term GPA, cumulative GPA, units attempted/earned, academic standing, and enrollment status. One record per student per period." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:AdmissionApplication a owl:Class ; rdfs:label "AdmissionApplication" ;
  rdfs:comment "An application for admission to the institution. Tracks the applicant's journey from submission through decision and enrollment intent." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:AidApplication a owl:Class ; rdfs:label "AidApplication" ;
  rdfs:comment "The FAFSA/ISIR (or institutional aid) application record for a student for a given aid year. Carries the Student Aid Index (SAI) that replaced EFC under FAFSA Simplification (2024-25), dependency status, Pell eligibility, verification selection, and NSLDS match flags. GLBA-covered customer information; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .
helix:AidPackage a owl:Class ; rdfs:label "AidPackage" ;
  rdfs:comment "Need analysis and packaging for a student for an aid year/period: full Cost of Attendance (COA) components, computed need, offered aid totals, unmet need, and professional judgment adjustments. GLBA-covered; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .
helix:AlumniProfile a owl:Class ; rdfs:label "AlumniProfile" ;
  rdfs:comment "An outcomes- and career-focused profile of an alumnus. This resource is DISTINCT from the Advancement Constituent resource: Constituent is giving/advancement-focused (donor segment, giving capacity, prospect stage), while AlumniProfile is career/engagement-focused (employer, career progression, mentoring, career services). The two are cross-linked via constituent_ref for the same person and MUST NOT duplicate giving data, refer to the Constituent record for all philanthropy/solicitation..." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:APVoucher a owl:Class ; rdfs:label "APVoucher" ;
  rdfs:comment "An accounts payable voucher, a supplier invoice approved for payment. Carries vendor, invoice, amount, payment, and worktag/chartfield distribution." ;
  helix:classification "internal" ;
  helix:inDomain helix:OtherDomain .
helix:ARTransaction a owl:Class ; rdfs:label "ARTransaction" ;
  rdfs:comment "An accounts receivable / student financials transaction, a charge, payment, or refund on a student account. FERPA/GLBA-relevant when linked to a student and financial aid." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OtherDomain .
helix:Asset a owl:Class ; rdfs:label "Asset" ;
  rdfs:comment "A capital asset, land, buildings, equipment, software. Carries acquisition cost, depreciation, location, custodian, and grant funding source." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:AwardHonor a owl:Class ; rdfs:label "AwardHonor" ;
  rdfs:comment "An honor, award, or distinction received by a student: Latin honors, dean's/president's list, departmental and institutional awards, national recognition, scholarships won, and honor-society memberships. NOTE: Honors and awards received are commonly designated as directory information under 34 CFR 99.3 and may be disclosable without consent unless the student has a directory-information restriction, see meta.ferpa_flags and the 'honors' category in restricted_categories." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:BenefitEnrollment a owl:Class ; rdfs:label "BenefitEnrollment" ;
  rdfs:comment "A benefit enrollment, an employee's election in a benefit plan (medical, dental, retirement, tuition waiver, etc.) with coverage level and contributions. Restricted; dependent PII tokenized." ;
  helix:classification "restricted" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:Budget a owl:Class ; rdfs:label "Budget" ;
  rdfs:comment "A budget line, planned, encumbered, expended, and available amounts by account/fund/department for a fiscal year." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:Campaign a owl:Class ; rdfs:label "Campaign" ;
  rdfs:comment "A fundraising campaign with goals, timelines, and progress tracking. May be a comprehensive campaign, annual fund, giving day, or targeted initiative." ;
  helix:classification "internal" ;
  helix:inDomain helix:AdvancementDomain .
helix:Compensation a owl:Class ; rdfs:label "Compensation" ;
  rdfs:comment "An employee compensation record, base pay, rate, grade/step, and compa-ratio. Restricted: individual pay data accessible only to HR and leadership." ;
  helix:classification "restricted" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:Constituent a owl:Class ; rdfs:label "Constituent" ;
  rdfs:comment "A person or organization with a relationship to the institution for advancement purposes: alumni, donors, parents, friends, corporate partners, foundations. Extends Person with advancement-specific attributes." ;
  helix:classification "confidential" ;
  helix:inDomain helix:AdvancementDomain .
helix:ContinuingEducation a owl:Class ; rdfs:label "ContinuingEducation" ;
  rdfs:comment "A graduate/professional continuing-education outcome for a graduate: enrollment in further study (master's, doctoral, professional school, second bachelor's, etc.) following completion of a program. Aligned with NACE First-Destination Standards, which count continuing education as a positive career outcome." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:Contract a owl:Class ; rdfs:label "Contract" ;
  rdfs:comment "A supplier contract, blanket POs, rate contracts, service agreements. Carries term, value, spend-to-date, and owner." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:Course a owl:Class ; rdfs:label "Course" ;
  rdfs:comment "A catalog-level course definition. Distinct from CourseSection, which is a specific offering in a term." ;
  helix:classification "internal" ;
  helix:inDomain helix:AcademicStructureDomain .
helix:CourseSection a owl:Class ; rdfs:label "CourseSection" ;
  rdfs:comment "A specific offering of a course in an academic period, with instructor, schedule, location, and capacity." ;
  helix:classification "internal" ;
  helix:inDomain helix:AcademicStructureDomain .
helix:Degree a owl:Class ; rdfs:label "Degree" ;
  rdfs:comment "A degree, certificate, or credential conferred upon a student." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:DegreeAudit a owl:Class ; rdfs:label "DegreeAudit" ;
  rdfs:comment "A point-in-time evaluation of a student's progress toward completing their program requirements. Links courses taken to requirements satisfied." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:Disbursement a owl:Class ; rdfs:label "Disbursement" ;
  rdfs:comment "An actual disbursement of a financial aid award to a student account for a term: scheduled vs actual dates, gross/net amounts, holds, refunds, and COD reporting status. Distinct from the FinAidAward offer. GLBA-covered; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .
helix:Employee a owl:Class ; rdfs:label "Employee" ;
  rdfs:comment "An employee / worker, the core HR identity. Links to a HELIX Person (a single human may be both Employee and Student). Carries hire/termination, worker type, FTE, FLSA, citizenship/visa, and contact info. SSN/national ID tokenized at silver." ;
  helix:classification "confidential" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:EmploymentOutcome a owl:Class ; rdfs:label "EmploymentOutcome" ;
  rdfs:comment "A first-destination or ongoing employment outcome for a graduate. Aligned with the NACE (National Association of Colleges and Employers) First-Destination Survey Standards, which define the standard for reporting career outcomes of graduating classes. Captures where and how a graduate is employed, salary, and relationship to the field of study. First-destination data is typically collected at or within six months of graduation." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:EngagementActivity a owl:Class ; rdfs:label "EngagementActivity" ;
  rdfs:comment "A trackable interaction between a constituent and the institution: event attendance, email engagement, volunteer activity, social media interaction, campus visit, or meeting with a development officer." ;
  helix:classification "internal" ;
  helix:inDomain helix:AdvancementDomain .
helix:Enrollment a owl:Class ; rdfs:label "Enrollment" ;
  rdfs:comment "A student's registration in a specific course section during an academic period." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:ExpenseReport a owl:Class ; rdfs:label "ExpenseReport" ;
  rdfs:comment "An employee expense report, travel and reimbursable expenses with line detail and worktag/chartfield distribution." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:ExperientialLearning a owl:Class ; rdfs:label "ExperientialLearning" ;
  rdfs:comment "An experiential learning activity: internship, co-op, practicum, clinical rotation, student teaching, undergraduate research, service learning, field experience, or capstone. These are recognized High-Impact Practices (HIPs) per NSSE (National Survey of Student Engagement) and are increasingly tracked as part of student success and career-readiness outcomes." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:FederalAidReport a owl:Class ; rdfs:label "FederalAidReport" ;
  rdfs:comment "An institution-level Title IV reporting artifact (COD, NSLDS enrollment reporting, FISAP, Pell/Direct Loan reconciliation): submission status, record counts, disbursement totals, and reconciliation variance. Aggregate institutional reporting, not a student education record." ;
  helix:classification "confidential" ;
  helix:inDomain helix:FinancialAidDomain .
helix:FERPARestriction a owl:Class ; rdfs:label "FERPARestriction" ;
  rdfs:comment "A student's FERPA directory information restriction. When active, directory information must be withheld from any disclosure not covered by a FERPA exception. Every downstream consumer of HELIX student data MUST check this resource before disclosing directory information." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OtherDomain .
helix:FinAidAward a owl:Class ; rdfs:label "FinAidAward" ;
  rdfs:comment "A financial aid award offered or disbursed to a student for an academic period." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .
helix:FinancialOrg a owl:Class ; rdfs:label "FinancialOrg" ;
  rdfs:comment "A financial organization unit, the cost center / department in the financial dimension (Workday Cost Center, PeopleSoft DeptID). Distinct from AcademicOrg, though the two often align. Used for financial reporting and budget ownership." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:FirstDestinationSurvey a owl:Class ; rdfs:label "FirstDestinationSurvey" ;
  rdfs:comment "A record of the NACE-standard First-Destination Survey instrument administered to a graduate. NACE defines a standard methodology: outcomes measured at six months post-graduation, with a reported 'knowledge rate' (the percentage of graduates for whom the institution has reasonable and verifiable outcome information). This resource tracks the survey lifecycle and the resulting outcome status." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:Fund a owl:Class ; rdfs:label "Fund" ;
  rdfs:comment "A fund, the fund-accounting dimension (GASB for public institutions, FASB ASU 2016-14 restriction classes for private). Normalizes GASB and FASB conventions into one taxonomy." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:Gift a owl:Class ; rdfs:label "Gift" ;
  rdfs:comment "A philanthropic transaction: gift, pledge, pledge payment, matching gift, planned gift, or in-kind donation to the institution." ;
  helix:classification "confidential" ;
  helix:inDomain helix:AdvancementDomain .
helix:GLTransaction a owl:Class ; rdfs:label "GLTransaction" ;
  rdfs:comment "A general ledger journal transaction, the atomic unit of financial accounting. Carries account, fund, department, program, amount, and ledger coding. Maps from PeopleSoft chartfields and Workday worktags." ;
  helix:classification "internal" ;
  helix:inDomain helix:OtherDomain .
helix:Grant a owl:Class ; rdfs:label "Grant" ;
  rdfs:comment "A sponsored program / grant award, the full lifecycle record for research and other externally funded awards. Carries sponsor, PI, CFDA, budget (direct/indirect), F&A rate, and cost sharing. Subject to 2 CFR 200 (Uniform Guidance) for federal awards." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:Hold a owl:Class ; rdfs:label "Hold" ;
  rdfs:comment "A restriction placed on a student's record that prevents specific actions (registration, transcript release, graduation, etc.) until resolved." ;
  helix:classification "confidential" ;
  helix:inDomain helix:StudentServicesDomain .
helix:Institution a owl:Class ; rdfs:label "Institution" ;
  rdfs:comment "A higher education institution, university, college, community college, or system office." ;
  helix:classification "public" ;
  helix:inDomain helix:IdentityDomain .
helix:InternationalStudent a owl:Class ; rdfs:label "InternationalStudent" ;
  rdfs:comment "Immigration and visa data for a non-citizen student. Covers F-1, J-1, M-1 visa holders, SEVIS tracking, I-20/DS-2019 program dates, and work authorization (CPT/OPT). Classified as restricted due to immigration data sensitivity." ;
  helix:classification "restricted" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:JobClassification a owl:Class ; rdfs:label "JobClassification" ;
  rdfs:comment "A job classification, the job profile/code with EEO/SOC classification and, for faculty, academic rank, tenure status, and IPEDS faculty category. Documents the recommended approach for faculty data Workday lacks natively." ;
  helix:classification "internal" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:LearningOutcome a owl:Class ; rdfs:label "LearningOutcome" ;
  rdfs:comment "A program-, course-, or institution-level learning outcome assessment result for a student. Supports institutional effectiveness and accreditation (regional and programmatic) assessment reporting: measuring attainment of Program Learning Outcomes (PLOs), general-education competencies, and professional competencies via direct and indirect assessment methods." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:LearningRecord a owl:Class ; rdfs:label "LearningRecord" ;
  rdfs:comment "A learning record, an employee's enrollment/completion of a training course (compliance, safety, professional development). Completion tracking is audit-sensitive for compliance training." ;
  helix:classification "internal" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:Licensure a owl:Class ; rdfs:label "Licensure" ;
  rdfs:comment "A professional licensure or certification exam outcome (e.g., NCLEX for nursing, CPA, bar exam, Praxis for teaching, USMLE for medicine). Licensure pass rates are a core programmatic accreditation reporting requirement for many professional programs and a key student outcome metric." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OutcomesDomain .
helix:LoanRecord a owl:Class ; rdfs:label "LoanRecord" ;
  rdfs:comment "A Direct Loan, Perkins, or other education loan originated for a student: type, status, loan period, MPN and counseling status, amounts, rate, and COD/servicer linkage. GLBA-covered; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .
helix:PayrollResult a owl:Class ; rdfs:label "PayrollResult" ;
  rdfs:comment "A payroll result, a processed pay statement for one pay period: gross, taxes, deductions, net, and labor distribution across funds/grants. Restricted; contains tax-linked data." ;
  helix:classification "restricted" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:PerformanceReview a owl:Class ; rdfs:label "PerformanceReview" ;
  rdfs:comment "A performance review, rating, goals, and 9-box talent placement. Restricted: accessible only to the employee, their management chain, HR, and leadership." ;
  helix:classification "restricted" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:Person a owl:Class ; rdfs:label "Person" ;
  rdfs:comment "A human being known to the institution in any capacity, student, employee, applicant, alumnus, donor, or contact. The foundational identity resource. Student, Employee, and other role-specific resources reference a Person." ;
  helix:classification "confidential" ;
  helix:inDomain helix:IdentityDomain .
helix:Position a owl:Class ; rdfs:label "Position" ;
  rdfs:comment "A position, the organizational 'seat' defined independently of who fills it. Carries job profile, supervisory org, compensation grade, EEO category, and funding source. Workday position-management model." ;
  helix:classification "internal" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:PositionBudget a owl:Class ; rdfs:label "PositionBudget" ;
  rdfs:comment "A position budget, funded amount, actuals, variance, and split funding across funds/grants for a position and fiscal year. Captures higher-ed split-funding and backfill patterns." ;
  helix:classification "internal" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:Program a owl:Class ; rdfs:label "Program" ;
  rdfs:comment "An academic program, degree, certificate, or credential track that a student pursues." ;
  helix:classification "internal" ;
  helix:inDomain helix:AcademicStructureDomain .
helix:PurchaseOrder a owl:Class ; rdfs:label "PurchaseOrder" ;
  rdfs:comment "A purchase order, a commitment to a supplier for goods or services. Carries lines, spend category, and worktag/chartfield distribution." ;
  helix:classification "internal" ;
  helix:inDomain helix:FinancialOperationsDomain .
helix:Requisition a owl:Class ; rdfs:label "Requisition" ;
  rdfs:comment "A job requisition, a position opening in recruiting, with applicant pipeline, disposition, and EEO data. Candidate PII is confidential; EEO data kept separate from hiring decisions." ;
  helix:classification "confidential" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:ReturnOfTitleIV a owl:Class ; rdfs:label "ReturnOfTitleIV" ;
  rdfs:comment "A Return of Title IV (R2T4) calculation when a student withdraws, per 34 CFR 668.22: percent enrolled/earned, earned vs unearned aid, amounts returned by school and student, and any post-withdrawal disbursement. GLBA-covered; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:OtherDomain .
helix:SAPEvaluation a owl:Class ; rdfs:label "SAPEvaluation" ;
  rdfs:comment "A Satisfactory Academic Progress evaluation for a student for a term/aid year per 34 CFR 668.34: qualitative (GPA) and quantitative (pace) measures, max-timeframe (150% rule) usage, and the appeal/academic-plan lifecycle. Classified confidential (FERPA education record)." ;
  helix:classification "confidential" ;
  helix:inDomain helix:OtherDomain .
helix:Student a owl:Class ; rdfs:label "Student" ;
  rdfs:comment "A person in their capacity as a learner at an institution. References a Person resource for base identity. Contains student-specific attributes: status, academic level, GPA, program enrollment, and classification." ;
  helix:classification "confidential" ;
  helix:inDomain helix:IdentityDomain .
helix:StudentEmployment a owl:Class ; rdfs:label "StudentEmployment" ;
  rdfs:comment "Federal Work-Study (FWS) or other student employment for an aid year: award, earnings tracking, community-service participation, job placement, and federal/institutional cost share. FWS/FISAP context. Classified confidential (FERPA education record)." ;
  helix:classification "confidential" ;
  helix:inDomain helix:FinancialAidDomain .
helix:StudentGroup a owl:Class ; rdfs:label "StudentGroup" ;
  rdfs:comment "A student's membership in an institutional group or cohort. Used for population management, IPEDS cohort tracking, targeted communications, and service delivery. Examples: student athletes, honors students, first-generation, veterans, TRIO participants." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:StudentProgram a owl:Class ; rdfs:label "StudentProgram" ;
  rdfs:comment "A student's enrollment in an academic program (major, minor, concentration, certificate). A student may have multiple active program enrollments simultaneously (e.g., double major, major + minor)." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:TimeEntry a owl:Class ; rdfs:label "TimeEntry" ;
  rdfs:comment "A time entry, reported hours for a non-exempt employee or student worker, with worktag/chartfield distribution and approval status." ;
  helix:classification "confidential" ;
  helix:inDomain helix:HumanResourcesDomain .
helix:TransferCredit a owl:Class ; rdfs:label "TransferCredit" ;
  rdfs:comment "Credit earned at another institution and accepted for transfer. Links the external course to the equivalent internal course and tracks how the credit applies." ;
  helix:classification "confidential" ;
  helix:inDomain helix:EnrollmentRegistrationDomain .
helix:Verification a owl:Class ; rdfs:label "Verification" ;
  rdfs:comment "Tracks the FAFSA verification lifecycle for a student/aid year per 34 CFR 668.51-.61: tracking group, required/received documents, conflicting-information resolution, and the SAI change resulting from verification. GLBA-covered; classified restricted." ;
  helix:classification "restricted" ;
  helix:inDomain helix:FinancialAidDomain .

helix:AbsenceRecord_employee_ref a owl:ObjectProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range helix:Employee ; rdfs:label "employee_ref" .
helix:AbsenceRecord_absence_type a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:string ; rdfs:label "absence_type" ; helix:codeSet helix:cs_absence_type .
helix:AbsenceRecord_start_date a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:date ; rdfs:label "start_date" .
helix:AbsenceRecord_end_date a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:date ; rdfs:label "end_date" .
helix:AbsenceRecord_hours_requested a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:decimal ; rdfs:label "hours_requested" .
helix:AbsenceRecord_fmla_qualifying a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:boolean ; rdfs:label "fmla_qualifying" .
helix:AbsenceRecord_fmla_hours_used a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:decimal ; rdfs:label "fmla_hours_used" .
helix:AbsenceRecord_status a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:string ; rdfs:label "status" .
helix:AbsenceRecord_balance_vacation a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:decimal ; rdfs:label "balance_vacation" .
helix:AbsenceRecord_balance_sick a owl:DatatypeProperty ; rdfs:domain helix:AbsenceRecord ; rdfs:range xsd:decimal ; rdfs:label "balance_sick" .
helix:AcademicOrg_institution_id a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "institution_id" .
helix:AcademicOrg_code a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "code" .
helix:AcademicOrg_name a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "name" .
helix:AcademicOrg_short_name a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "short_name" .
helix:AcademicOrg_org_type a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "org_type" .
helix:AcademicOrg_parent_org_ref a owl:ObjectProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range helix:AcademicOrg ; rdfs:label "parent_org_ref" .
helix:AcademicOrg_dean_or_chair a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:string ; rdfs:label "dean_or_chair" .
helix:AcademicOrg_is_active a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:boolean ; rdfs:label "is_active" .
helix:AcademicOrg_effective_date a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:date ; rdfs:label "effective_date" .
helix:AcademicOrg_end_date a owl:DatatypeProperty ; rdfs:domain helix:AcademicOrg ; rdfs:range xsd:date ; rdfs:label "end_date" .
helix:AcademicPeriod_institution_id a owl:DatatypeProperty ; rdfs:domain helix:AcademicPeriod ; rdfs:range xsd:string ; rdfs:label "institution_id" .
helix:AcademicPeriod_period_type a owl:DatatypeProperty ; rdfs:domain helix:AcademicPeriod ; rdfs:range xsd:string ; rdfs:label "period_type" ; helix:codeSet helix:cs_period_type .
helix:AcademicPeriod_code a owl:DatatypeProperty ; rdfs:domain helix:AcademicPeriod ; rdfs:range xsd:string ; rdfs:label "code" .
