{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixedu.org/templates/context/definition-review.schema.json",
  "title": "HELIX Definition Review Sheet",
  "version": "0.1",
  "description": "One row per column of a custom or historical table. Drafted by tools/draft_custom_table_context.py and a model (prompts/draft-definitions.md), decided by a data steward, published by tools/apply_glue_context.py. Only rows with status approved are published.",
  "type": "object",
  "required": [
    "review_id",
    "source_table",
    "column_name",
    "status"
  ],
  "properties": {
    "review_id": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_table": {
      "type": "string"
    },
    "column_name": {
      "type": "string"
    },
    "data_type": {
      "type": "string"
    },
    "profile_summary": {
      "type": "string",
      "description": "Counts and shapes from profile-table.sql. Never row values from confidential or restricted columns."
    },
    "register_id": {
      "type": "string",
      "description": "Customization register row (docs/conversion/)."
    },
    "candidate_1": {
      "type": "string",
      "description": "Best HELIX match as Resource.attribute, or a meta field for audit columns."
    },
    "candidate_1_score": {
      "type": [
        "number",
        "string"
      ]
    },
    "candidate_1_reason": {
      "type": "string"
    },
    "candidate_2": {
      "type": "string"
    },
    "candidate_2_score": {
      "type": [
        "number",
        "string"
      ]
    },
    "candidate_3": {
      "type": "string"
    },
    "candidate_3_score": {
      "type": [
        "number",
        "string"
      ]
    },
    "proposed_classification": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ]
    },
    "classification_reason": {
      "type": "string"
    },
    "drafted_definition": {
      "type": "string",
      "description": "Model draft. Never published directly."
    },
    "drafted_by": {
      "type": "string"
    },
    "steward_definition": {
      "type": "string",
      "description": "The definition that gets published. Required for approval."
    },
    "steward_classification": {
      "type": "string",
      "enum": [
        "",
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "description": "Can raise the proposed level. Lowering it needs the data trustee and is refused by the publisher."
    },
    "helix_link": {
      "type": "string",
      "description": "Resource.attribute this column maps to, or 'extension:<name>' for a local extension (govern/schema-evolution-policy.json), or 'none'."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "needs_info",
        "approved",
        "rejected"
      ]
    },
    "steward": {
      "type": "string"
    },
    "reviewed_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  }
}