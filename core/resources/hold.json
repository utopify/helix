{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixedu.org/core/resources/hold.json",
  "title": "HELIX Hold Resource",
  "description": "A restriction placed on a student's record that prevents specific actions (registration, transcript release, graduation, etc.) until resolved.",
  "type": "object",
  "required": [
    "helix_id",
    "student_ref",
    "hold_type",
    "hold_status"
  ],
  "properties": {
    "helix_id": {
      "type": "string",
      "format": "uuid"
    },
    "student_ref": {
      "type": "string"
    },
    "hold_type": {
      "type": "string",
      "enum": [
        "registration",
        "financial",
        "academic",
        "disciplinary",
        "transcript",
        "graduation",
        "library",
        "health_compliance",
        "admissions",
        "other"
      ],
      "description": "Bound to HELIX terminology: helix/hold-type."
    },
    "hold_status": {
      "type": "string",
      "enum": [
        "active",
        "released",
        "expired"
      ]
    },
    "reason": {
      "type": "string",
      "description": "Human-readable reason for the hold (e.g., 'Unpaid balance', 'Missing immunization records')"
    },
    "hold_code": {
      "type": "string",
      "description": "Institution's internal hold code"
    },
    "placed_date": {
      "type": "string",
      "format": "date"
    },
    "released_date": {
      "type": "string",
      "format": "date"
    },
    "expiration_date": {
      "type": "string",
      "format": "date",
      "description": "Date the hold auto-expires if not released"
    },
    "placed_by_office": {
      "type": "string",
      "description": "Office or department that placed the hold"
    },
    "prevents": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "registration",
          "transcript_release",
          "graduation",
          "grade_viewing",
          "diploma_release",
          "enrollment_verification",
          "other"
        ]
      },
      "description": "What actions this hold prevents"
    },
    "amount_owed": {
      "type": "number",
      "description": "For financial holds, the outstanding balance"
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "meta": {
      "type": "object",
      "description": "HELIX metadata block \u2014 present on every resource",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Resource version number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_system": {
          "type": "string"
        },
        "data_owner": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "default": "confidential"
        },
        "ferpa_flags": {
          "type": "object",
          "description": "FERPA enforcement flags, applied at Bronze->Silver identity resolution and checked by every consumer before disclosure. See govern/ferpa-disclosure-framework.json.",
          "properties": {
            "is_education_record": {
              "type": "boolean",
              "default": true,
              "description": "True if this record is a FERPA education record (34 CFR 99.3)."
            },
            "disclosure_basis_required": {
              "type": "boolean",
              "default": true,
              "description": "If true, a consumer must assert a valid 34 CFR 99.31 disclosure basis (or hold 99.30 consent) before data is returned."
            },
            "directory_restricted": {
              "type": "boolean",
              "default": false,
              "description": "True when the student has an active directory-information opt-out (from FERPARestriction.restrict_directory). When true, NO directory information may be disclosed under the 99.31(a)(11) directory exception."
            },
            "restricted_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "address",
                  "phone",
                  "email",
                  "enrollment_status",
                  "dates_of_attendance",
                  "degrees_awarded",
                  "honors",
                  "major_field",
                  "photo",
                  "participation_activities"
                ]
              },
              "description": "Specific directory-information categories the student restricted (99.37). A field in this list must be withheld even if directory_restricted is false."
            },
            "legitimate_interest_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Roles/purposes pre-authorized as school officials with legitimate educational interest for this record (drives the 99.31(a)(1) check)."
            },
            "study_disclosure_allowed": {
              "type": "boolean",
              "default": false,
              "description": "Whether this record may be released under a 99.31(a)(6) studies agreement (typically de-identified or under a written agreement)."
            }
          }
        }
      }
    }
  },
  "definitions": {
    "helix_meta": {
      "type": "object",
      "description": "HELIX metadata block \u2014 present on every resource",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Resource version number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_system": {
          "type": "string"
        },
        "data_owner": {
          "type": "string"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ]
        }
      }
    }
  }
}