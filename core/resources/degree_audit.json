{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixedu.org/core/resources/degree_audit.json",
  "title": "HELIX DegreeAudit Resource",
  "description": "A point-in-time evaluation of a student's progress toward completing their program requirements. Links courses taken to requirements satisfied.",
  "type": "object",
  "required": [
    "helix_id",
    "student_ref",
    "program_ref",
    "audit_date"
  ],
  "properties": {
    "helix_id": {
      "type": "string",
      "description": "HELIX-assigned unique identifier for this audit."
    },
    "student_ref": {
      "type": "string",
      "description": "Reference to the HELIX Student resource."
    },
    "program_ref": {
      "type": "string",
      "description": "Reference to the HELIX Program resource."
    },
    "catalog_year": {
      "type": "string",
      "description": "The catalog year governing this student's requirements (e.g., '2024-2025')."
    },
    "audit_date": {
      "type": "string",
      "format": "date",
      "description": "Date the audit was run."
    },
    "overall_status": {
      "type": "string",
      "enum": [
        "in_progress",
        "complete",
        "deficient"
      ],
      "description": "Overall completion status."
    },
    "completion_percentage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of requirements satisfied."
    },
    "total_requirements": {
      "type": "integer",
      "description": "Total requirement count."
    },
    "satisfied_count": {
      "type": "integer",
      "description": "Requirements fully satisfied."
    },
    "in_progress_count": {
      "type": "integer",
      "description": "Requirements being met by current enrollment."
    },
    "unsatisfied_count": {
      "type": "integer",
      "description": "Requirements not yet met."
    },
    "units_required": {
      "type": "number",
      "description": "Total credits required by the program."
    },
    "units_completed": {
      "type": "number",
      "description": "Credits earned toward the program."
    },
    "units_in_progress": {
      "type": "number",
      "description": "Credits currently enrolled."
    },
    "units_remaining": {
      "type": "number",
      "description": "Credits still needed."
    },
    "gpa_required": {
      "type": "number",
      "description": "Minimum GPA required for completion."
    },
    "gpa_current": {
      "type": "number",
      "description": "Current GPA in program courses."
    },
    "projected_completion_date": {
      "type": "string",
      "format": "date",
      "description": "Estimated graduation date."
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "requirement_name": {
            "type": "string"
          },
          "requirement_type": {
            "type": "string",
            "enum": [
              "core",
              "major",
              "minor",
              "general_education",
              "elective",
              "concentration",
              "capstone",
              "thesis"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "satisfied",
              "in_progress",
              "not_satisfied",
              "waived"
            ]
          },
          "courses_applied": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Course references that satisfy this requirement."
          }
        }
      },
      "description": "Individual requirements with status."
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_system": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "const": "0.1"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "default": "confidential"
        },
        "ferpa_flags": {
          "type": "object",
          "description": "FERPA enforcement flags, applied at Bronze->Silver identity resolution and checked by every consumer before disclosure. See govern/ferpa-disclosure-framework.json.",
          "properties": {
            "is_education_record": {
              "type": "boolean",
              "default": true,
              "description": "True if this record is a FERPA education record (34 CFR 99.3)."
            },
            "disclosure_basis_required": {
              "type": "boolean",
              "default": true,
              "description": "If true, a consumer must assert a valid 34 CFR 99.31 disclosure basis (or hold 99.30 consent) before data is returned."
            },
            "directory_restricted": {
              "type": "boolean",
              "default": false,
              "description": "True when the student has an active directory-information opt-out (from FERPARestriction.restrict_directory). When true, NO directory information may be disclosed under the 99.31(a)(11) directory exception."
            },
            "restricted_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "address",
                  "phone",
                  "email",
                  "enrollment_status",
                  "dates_of_attendance",
                  "degrees_awarded",
                  "honors",
                  "major_field",
                  "photo",
                  "participation_activities"
                ]
              },
              "description": "Specific directory-information categories the student restricted (99.37). A field in this list must be withheld even if directory_restricted is false."
            },
            "legitimate_interest_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Roles/purposes pre-authorized as school officials with legitimate educational interest for this record (drives the 99.31(a)(1) check)."
            },
            "study_disclosure_allowed": {
              "type": "boolean",
              "default": false,
              "description": "Whether this record may be released under a 99.31(a)(6) studies agreement (typically de-identified or under a written agreement)."
            }
          }
        }
      }
    }
  }
}