{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixedu.org/core/resources/loan_record.json",
  "title": "HELIX LoanRecord Resource",
  "description": "A Direct Loan, Perkins, or other education loan originated for a student: type, status, loan period, MPN and counseling status, amounts, rate, and COD/servicer linkage. GLBA-covered; classified restricted.",
  "type": "object",
  "required": [
    "helix_id",
    "student_ref",
    "academic_year",
    "loan_type",
    "loan_status"
  ],
  "properties": {
    "helix_id": {
      "type": "string",
      "format": "uuid",
      "description": "HELIX unique identifier"
    },
    "student_ref": {
      "type": "string",
      "description": "HELIX ID of the Student"
    },
    "academic_year": {
      "type": "string",
      "description": "Aid year in YYYY-YYYY format"
    },
    "loan_type": {
      "type": "string",
      "description": "Bound to helix/loan-type."
    },
    "loan_status": {
      "type": "string",
      "description": "Bound to helix/loan-status."
    },
    "loan_period_start": {
      "type": "string",
      "format": "date"
    },
    "loan_period_end": {
      "type": "string",
      "format": "date"
    },
    "mpn_flag": {
      "type": "boolean",
      "description": "Master Promissory Note signed."
    },
    "mpn_date": {
      "type": "string",
      "format": "date"
    },
    "mpn_expiration_date": {
      "type": "string",
      "format": "date"
    },
    "entrance_counseling_flag": {
      "type": "boolean"
    },
    "entrance_counseling_date": {
      "type": "string",
      "format": "date"
    },
    "exit_counseling_flag": {
      "type": "boolean"
    },
    "exit_counseling_date": {
      "type": "string",
      "format": "date"
    },
    "gross_loan_amount": {
      "type": "number"
    },
    "net_loan_amount": {
      "type": "number"
    },
    "origination_fee": {
      "type": "number"
    },
    "interest_rate": {
      "type": "number",
      "description": "Fixed interest rate (percentage)."
    },
    "subsidized_flag": {
      "type": "boolean"
    },
    "loan_disbursement_count": {
      "type": "integer"
    },
    "cod_loan_id": {
      "type": "string",
      "description": "COD award/loan ID."
    },
    "servicer_name": {
      "type": "string"
    },
    "grade_level": {
      "type": "string",
      "description": "Grade level for annual loan limit determination."
    },
    "dependency_at_origination": {
      "type": "string",
      "enum": [
        "dependent",
        "independent"
      ]
    },
    "aggregate_loan_limit_check_flag": {
      "type": "boolean"
    },
    "annual_loan_limit_check_flag": {
      "type": "boolean"
    },
    "meta": {
      "type": "object",
      "description": "HELIX metadata block \u2014 present on every resource",
      "properties": {
        "version": {
          "type": "integer",
          "description": "Resource version number"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "source_system": {
          "type": "string",
          "description": "Originating system (e.g., 'banner', 'peoplesoft', 'workday')"
        },
        "data_owner": {
          "type": "string",
          "description": "Role or person responsible for data quality"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "description": "Data classification tier per HELIX Govern",
          "default": "restricted"
        },
        "ferpa_flags": {
          "type": "object",
          "description": "FERPA enforcement flags, applied at Bronze->Silver identity resolution and checked by every consumer before disclosure. See govern/ferpa-disclosure-framework.json.",
          "properties": {
            "is_education_record": {
              "type": "boolean",
              "default": true,
              "description": "True if this record is a FERPA education record (34 CFR 99.3)."
            },
            "disclosure_basis_required": {
              "type": "boolean",
              "default": true,
              "description": "If true, a consumer must assert a valid 34 CFR 99.31 disclosure basis (or hold 99.30 consent) before data is returned."
            },
            "directory_restricted": {
              "type": "boolean",
              "default": false,
              "description": "True when the student has an active directory-information opt-out (from FERPARestriction.restrict_directory). When true, NO directory information may be disclosed under the 99.31(a)(11) directory exception."
            },
            "restricted_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "address",
                  "phone",
                  "email",
                  "enrollment_status",
                  "dates_of_attendance",
                  "degrees_awarded",
                  "honors",
                  "major_field",
                  "photo",
                  "participation_activities"
                ]
              },
              "description": "Specific directory-information categories the student restricted (99.37). A field in this list must be withheld even if directory_restricted is false."
            },
            "legitimate_interest_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Roles/purposes pre-authorized as school officials with legitimate educational interest for this record (drives the 99.31(a)(1) check)."
            },
            "study_disclosure_allowed": {
              "type": "boolean",
              "default": false,
              "description": "Whether this record may be released under a 99.31(a)(6) studies agreement (typically de-identified or under a written agreement)."
            }
          }
        }
      }
    }
  }
}