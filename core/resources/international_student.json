{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://helixedu.org/core/resources/international_student.json",
  "title": "HELIX InternationalStudent Resource",
  "description": "Immigration and visa data for a non-citizen student. Covers F-1, J-1, M-1 visa holders, SEVIS tracking, I-20/DS-2019 program dates, and work authorization (CPT/OPT). Classified as restricted due to immigration data sensitivity.",
  "type": "object",
  "required": [
    "helix_id",
    "student_ref",
    "country_of_citizenship",
    "visa_type"
  ],
  "properties": {
    "helix_id": {
      "type": "string",
      "description": "HELIX-assigned unique identifier."
    },
    "student_ref": {
      "type": "string",
      "description": "Reference to the HELIX Student resource."
    },
    "country_of_citizenship": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code."
    },
    "country_of_birth": {
      "type": "string",
      "description": "ISO 3166-1 alpha-2 country code."
    },
    "visa_type": {
      "type": "string",
      "enum": [
        "f1",
        "j1",
        "m1",
        "h1b",
        "h4",
        "l1",
        "tn",
        "o1",
        "other",
        "permanent_resident",
        "asylee_refugee"
      ],
      "description": "Visa/immigration classification."
    },
    "visa_status": {
      "type": "string",
      "enum": [
        "active",
        "expired",
        "pending",
        "revoked"
      ],
      "description": "Current visa status."
    },
    "visa_issue_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "visa_expiry_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "sevis_id": {
      "type": [
        "string",
        "null"
      ],
      "description": "SEVIS N-number (e.g., N0012345678). Restricted."
    },
    "sevis_status": {
      "type": "string",
      "enum": [
        "initial",
        "active",
        "completed",
        "terminated",
        "transferred_out",
        "transferred_in"
      ],
      "description": "SEVIS record status."
    },
    "i20_program_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Program start date on I-20 (F-1) or DS-2019 (J-1)."
    },
    "i20_program_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date",
      "description": "Program completion date on I-20/DS-2019."
    },
    "work_authorization": {
      "type": "string",
      "enum": [
        "none",
        "cpt",
        "opt",
        "stem_opt",
        "academic_training",
        "economic_hardship",
        "on_campus"
      ],
      "description": "Current work authorization type."
    },
    "work_auth_start_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "work_auth_end_date": {
      "type": [
        "string",
        "null"
      ],
      "format": "date"
    },
    "english_proficiency_test": {
      "type": "string",
      "enum": [
        "toefl",
        "ielts",
        "duolingo",
        "pte",
        "cambridge",
        "waived",
        "other"
      ],
      "description": "English proficiency exam taken."
    },
    "english_proficiency_score": {
      "type": [
        "string",
        "null"
      ],
      "description": "Test score (format varies by test)."
    },
    "sponsor": {
      "type": [
        "string",
        "null"
      ],
      "description": "Sponsoring organization (for J-1) or government sponsor."
    },
    "meta": {
      "type": "object",
      "properties": {
        "source_system": {
          "type": "string"
        },
        "source_id": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "const": "0.1"
        },
        "classification": {
          "type": "string",
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted"
          ],
          "default": "restricted"
        },
        "ferpa_flags": {
          "type": "object",
          "description": "FERPA enforcement flags, applied at Bronze->Silver identity resolution and checked by every consumer before disclosure. See govern/ferpa-disclosure-framework.json.",
          "properties": {
            "is_education_record": {
              "type": "boolean",
              "default": true,
              "description": "True if this record is a FERPA education record (34 CFR 99.3)."
            },
            "disclosure_basis_required": {
              "type": "boolean",
              "default": true,
              "description": "If true, a consumer must assert a valid 34 CFR 99.31 disclosure basis (or hold 99.30 consent) before data is returned."
            },
            "directory_restricted": {
              "type": "boolean",
              "default": false,
              "description": "True when the student has an active directory-information opt-out (from FERPARestriction.restrict_directory). When true, NO directory information may be disclosed under the 99.31(a)(11) directory exception."
            },
            "restricted_categories": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": [
                  "name",
                  "address",
                  "phone",
                  "email",
                  "enrollment_status",
                  "dates_of_attendance",
                  "degrees_awarded",
                  "honors",
                  "major_field",
                  "photo",
                  "participation_activities"
                ]
              },
              "description": "Specific directory-information categories the student restricted (99.37). A field in this list must be withheld even if directory_restricted is false."
            },
            "legitimate_interest_scope": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Roles/purposes pre-authorized as school officials with legitimate educational interest for this record (drives the 99.31(a)(1) check)."
            },
            "study_disclosure_allowed": {
              "type": "boolean",
              "default": false,
              "description": "Whether this record may be released under a 99.31(a)(6) studies agreement (typically de-identified or under a written agreement)."
            }
          }
        }
      }
    }
  }
}