{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft Contracts \u2192 Contract",
  "source_system": "peoplesoft",
  "module": "Financials - Contracts / Supplier Contracts",
  "target_resource": "Contract",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_CNTRCT_HDR",
      "description": "Contract header: BUSINESS_UNIT, CONTRACT_ID, VENDOR_ID, CONTRACT_TYPE, CONTRACT_STATUS (A=active, E=expired, H=hold, C=canceled), BEGIN_DT, END_DT, MAX_AMT, RENEWAL_FLG."
    },
    {
      "object": "PS_CNTRCT_LINE",
      "description": "Contract lines: CONTRACT_ID, LINE_NBR, DESCR, PRICE, QTY, CATEGORY_CD, ACCOUNT, FUND_CODE, DEPTID."
    },
    {
      "object": "PS_CNTRCT_RELEASE",
      "description": "Release orders against the contract: PO_ID linkage, released amounts."
    },
    {
      "object": "PS_VENDOR",
      "description": "Vendor master (shared with AP/Purchasing)."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "contract_id",
      "source": "PS_CNTRCT_HDR.BUSINESS_UNIT + CONTRACT_ID",
      "transformation": "Composite key."
    },
    {
      "helix_attribute": "contract_name",
      "source": "PS_CNTRCT_HDR.DESCR254 or PS_CNTRCT_LINE.DESCR (first line)",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "vendor_id",
      "source": "PS_CNTRCT_HDR.VENDOR_ID",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "vendor_name",
      "source": "PS_VENDOR.NAME1",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "contract_type",
      "source": "PS_CNTRCT_HDR.CONTRACT_TYPE",
      "transformation": "Map: 'BLK' \u2192 'blanket', 'RT' \u2192 'rate', 'SVC' \u2192 'service'."
    },
    {
      "helix_attribute": "start_date",
      "source": "PS_CNTRCT_HDR.BEGIN_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "end_date",
      "source": "PS_CNTRCT_HDR.END_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "total_value",
      "source": "PS_CNTRCT_HDR.MAX_AMT",
      "transformation": "Total contract value / not-to-exceed amount."
    },
    {
      "helix_attribute": "amount_spent",
      "source": "Sum of PS_CNTRCT_RELEASE amounts invoiced",
      "transformation": "Total invoiced against the contract."
    },
    {
      "helix_attribute": "contract_status",
      "source": "PS_CNTRCT_HDR.CONTRACT_STATUS",
      "transformation": "Map: 'A' \u2192 'active', 'E' \u2192 'expired', 'H' \u2192 'on_hold', 'C' \u2192 'canceled'."
    },
    {
      "helix_attribute": "owner",
      "source": "PS_CNTRCT_HDR.OPRID or BUYER_ID",
      "transformation": "Resolve to name. Contract administrator."
    },
    {
      "helix_attribute": "department",
      "source": "PS_CNTRCT_LINE.DEPTID",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "fund_code",
      "source": "PS_CNTRCT_LINE.FUND_CODE",
      "transformation": "Map to HELIX fund code."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}