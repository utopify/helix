{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft Expenses \u2192 ExpenseReport",
  "source_system": "peoplesoft",
  "module": "Financials - Expenses / Travel",
  "target_resource": "ExpenseReport",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_EX_SHEET_HDR",
      "description": "Expense report header: EMPLID, SHEET_ID, BUSINESS_PURPOSE, TRIP_BEG_DT, TRIP_END_DT, TOTAL_AMT, SHEET_STATUS (PND=pending, APR=approved, PAD=paid, DEN=denied)."
    },
    {
      "object": "PS_EX_SHEET_LINE",
      "description": "Expense lines: SHEET_ID, LINE_SEQ_NBR, EXPENSE_TYPE, EXPENSE_DT, MONETARY_AMOUNT, DESCR254, RECEIPT_STATUS."
    },
    {
      "object": "PS_EX_LINE_DIST",
      "description": "Line distributions (ChartFields): ACCOUNT, FUND_CODE, DEPTID, PROGRAM_CODE, PROJECT_ID, MONETARY_AMOUNT."
    },
    {
      "object": "PS_EX_ACCTG_LINE",
      "description": "Expense accounting lines \u2014 GL distribution for posted expenses."
    },
    {
      "object": "PS_EX_ADVANCE",
      "description": "Travel advances: ADVANCE_ID, ADVANCE_AMT, ADVANCE_STATUS. Must be reconciled against the expense report."
    },
    {
      "object": "PS_EXPENSE_TYPE_TBL",
      "description": "Expense type definitions: EXPENSE_TYPE, DESCR, RATE (per diem/mileage rates)."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "report_id",
      "source": "PS_EX_SHEET_HDR.EMPLID + SHEET_ID",
      "transformation": "Composite key."
    },
    {
      "helix_attribute": "employee_ref",
      "source": "PS_EX_SHEET_HDR.EMPLID",
      "transformation": "Resolve to HELIX employee_id."
    },
    {
      "helix_attribute": "report_date",
      "source": "PS_EX_SHEET_HDR.CREATION_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "purpose",
      "source": "PS_EX_SHEET_HDR.BUSINESS_PURPOSE",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "total_amount",
      "source": "PS_EX_SHEET_HDR.TOTAL_AMT",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "report_status",
      "source": "PS_EX_SHEET_HDR.SHEET_STATUS",
      "transformation": "Map: 'PND' \u2192 'submitted', 'APR' \u2192 'approved', 'PAD' \u2192 'paid', 'DEN' \u2192 'denied', 'SBM' \u2192 'submitted'."
    },
    {
      "helix_attribute": "expense_type",
      "source": "PS_EX_SHEET_LINE.EXPENSE_TYPE \u2192 PS_EXPENSE_TYPE_TBL.DESCR",
      "transformation": "Map: 'AIR' \u2192 'airfare', 'HOTEL' \u2192 'lodging', 'MEALS' \u2192 'meals', 'MILE' \u2192 'mileage', 'REG' \u2192 'registration', 'TAXI' \u2192 'ground_transport'."
    },
    {
      "helix_attribute": "line_amount",
      "source": "PS_EX_SHEET_LINE.MONETARY_AMOUNT",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "line_date",
      "source": "PS_EX_SHEET_LINE.EXPENSE_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "account",
      "source": "PS_EX_LINE_DIST.ACCOUNT",
      "transformation": "Map to HELIX account code."
    },
    {
      "helix_attribute": "fund_code",
      "source": "PS_EX_LINE_DIST.FUND_CODE",
      "transformation": "Map to HELIX fund code."
    },
    {
      "helix_attribute": "department",
      "source": "PS_EX_LINE_DIST.DEPTID",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "grant_ref",
      "source": "PS_EX_LINE_DIST.PROJECT_ID",
      "transformation": "If charged to a grant. Federal travel: Fly America Act, GSA per diem limits apply."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}