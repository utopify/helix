{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft Asset Management \u2192 Asset",
  "source_system": "peoplesoft",
  "module": "Financials - Asset Management (AM)",
  "target_resource": "Asset",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_ASSET",
      "description": "Asset master: BUSINESS_UNIT, ASSET_ID, DESCR, TAG_NUMBER, SERIAL_ID, ASSET_STATUS (A=active, D=disposed, T=transferred), ACQUISITION_DT, COST, IN_SERVICE_DT."
    },
    {
      "object": "PS_ASSET_ACQ_DET",
      "description": "Acquisition detail: PO_ID, VENDOR_ID, INVOICE_ID. Links asset to the PO that purchased it."
    },
    {
      "object": "PS_COST",
      "description": "Asset cost and book values: COST, ACCUM_DEPR_AMT, NET_BOOK_VAL, DEPR_METHOD (SL=straight-line, DB=declining balance), LIFE."
    },
    {
      "object": "PS_ASSET_CAT_TBL",
      "description": "Asset category: CATEGORY_CD, DESCR, USEFUL_LIFE, DEPR_METHOD. Drives depreciation rules."
    },
    {
      "object": "PS_ASSET_LOCAT",
      "description": "Asset physical location: BUILDING, ROOM, CUSTODIAN_ID, LOCATION_CD."
    },
    {
      "object": "PS_ASSET_DIST",
      "description": "Asset ChartField distribution: ACCOUNT, FUND_CODE, DEPTID, PROJECT_ID. Where the asset cost is booked."
    },
    {
      "object": "PS_ASSET_DISP",
      "description": "Disposal records: DISPOSAL_DT, DISPOSAL_TYPE (S=sold, R=retired, T=traded, D=donated), PROCEEDS."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "asset_id",
      "source": "PS_ASSET.BUSINESS_UNIT + ASSET_ID",
      "transformation": "Composite key."
    },
    {
      "helix_attribute": "description",
      "source": "PS_ASSET.DESCR",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "asset_category",
      "source": "PS_ASSET_CAT_TBL.CATEGORY_CD + DESCR",
      "transformation": "Map: 'LAND' \u2192 'land', 'BLDG' \u2192 'building', 'EQUIP' \u2192 'equipment', 'SOFT' \u2192 'software', 'VEH' \u2192 'vehicle', 'LHI' \u2192 'leasehold', 'LIB' \u2192 'library', 'CIP' \u2192 'cip'."
    },
    {
      "helix_attribute": "acquisition_date",
      "source": "PS_ASSET.ACQUISITION_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "acquisition_cost",
      "source": "PS_COST.COST",
      "transformation": "Original cost."
    },
    {
      "helix_attribute": "useful_life_months",
      "source": "PS_COST.LIFE or PS_ASSET_CAT_TBL.USEFUL_LIFE",
      "transformation": "Convert to months if stored in years."
    },
    {
      "helix_attribute": "salvage_value",
      "source": "PS_COST.SALVAGE_VALUE",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "depreciation_method",
      "source": "PS_COST.DEPR_METHOD",
      "transformation": "Map: 'SL' \u2192 'straight_line', 'DB' \u2192 'declining_balance'."
    },
    {
      "helix_attribute": "accumulated_depreciation",
      "source": "PS_COST.ACCUM_DEPR_AMT",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "net_book_value",
      "source": "PS_COST.NET_BOOK_VAL",
      "transformation": "cost - accumulated_depreciation."
    },
    {
      "helix_attribute": "location_building",
      "source": "PS_ASSET_LOCAT.BUILDING",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "location_room",
      "source": "PS_ASSET_LOCAT.ROOM",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "custodian",
      "source": "PS_ASSET_LOCAT.CUSTODIAN_ID \u2192 name",
      "transformation": "Resolve to name."
    },
    {
      "helix_attribute": "department",
      "source": "PS_ASSET_DIST.DEPTID",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "fund_code",
      "source": "PS_ASSET_DIST.FUND_CODE",
      "transformation": "Map to HELIX fund code."
    },
    {
      "helix_attribute": "grant_ref",
      "source": "PS_ASSET_DIST.PROJECT_ID",
      "transformation": "If purchased on a grant. Subject to 2 CFR 200.313 federal equipment rules."
    },
    {
      "helix_attribute": "status",
      "source": "PS_ASSET.ASSET_STATUS",
      "transformation": "Map: 'A' \u2192 'in_service', 'D' \u2192 'disposed', 'T' \u2192 'transferred', 'N' \u2192 'not_in_service'."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}