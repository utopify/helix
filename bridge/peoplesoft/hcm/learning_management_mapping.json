{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft HCM \u2192 LearningRecord",
  "source_system": "peoplesoft",
  "module": "HCM - Enterprise Learning Management (ELM)",
  "target_resource": "LearningRecord",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_TRAINING",
      "description": "Training enrollment/completion: EMPLID, COURSE (course code), COURSE_TITLE, SESSION_NBR, ATTENDANCE (C=completed, E=enrolled, N=no-show, W=waived), TRAINING_DT, SCORE."
    },
    {
      "object": "PS_TRAINING_TBL",
      "description": "Course catalog: COURSE, DESCR, TRAINING_TYPE (compliance, safety, professional, technical, onboarding), DELIVERY_METHOD (ILT, WBT, BLE)."
    },
    {
      "object": "PS_TRN_ASSIGN",
      "description": "Training assignments (required/mandatory): EMPLID, COURSE, REQUIRED_FLAG, DUE_DT."
    },
    {
      "object": "PS_TRN_COMPLETION",
      "description": "Completion records: EMPLID, COURSE, COMPLETION_DT, EXPIRATION_DT (for certifications)."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "employee_ref",
      "source": "PS_TRAINING.EMPLID",
      "transformation": "Resolve to HELIX employee_id."
    },
    {
      "helix_attribute": "course_id",
      "source": "PS_TRAINING.COURSE",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "course_title",
      "source": "PS_TRAINING_TBL.DESCR or PS_TRAINING.COURSE_TITLE",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "course_type",
      "source": "PS_TRAINING_TBL.TRAINING_TYPE",
      "transformation": "Map: compliance, safety, professional_dev, technical, onboarding, leadership."
    },
    {
      "helix_attribute": "delivery_method",
      "source": "PS_TRAINING_TBL.DELIVERY_METHOD",
      "transformation": "Map: 'ILT' \u2192 'in_person', 'WBT' \u2192 'online_async', 'VILT' \u2192 'online_sync', 'BLE' \u2192 'blended'."
    },
    {
      "helix_attribute": "enrollment_date",
      "source": "PS_TRAINING.TRAINING_DT (enrollment date)",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "completion_date",
      "source": "PS_TRN_COMPLETION.COMPLETION_DT",
      "transformation": "Null if not completed."
    },
    {
      "helix_attribute": "status",
      "source": "PS_TRAINING.ATTENDANCE",
      "transformation": "Map: 'C' \u2192 'completed', 'E' \u2192 'enrolled', 'N' \u2192 'not_started', 'W' \u2192 'waived'."
    },
    {
      "helix_attribute": "score",
      "source": "PS_TRAINING.SCORE",
      "transformation": "Direct map if applicable."
    },
    {
      "helix_attribute": "required",
      "source": "PS_TRN_ASSIGN.REQUIRED_FLAG = 'Y'",
      "transformation": "Boolean."
    },
    {
      "helix_attribute": "due_date",
      "source": "PS_TRN_ASSIGN.DUE_DT",
      "transformation": "For mandatory training: compliance deadline."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}