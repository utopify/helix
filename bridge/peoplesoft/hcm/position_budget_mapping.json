{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft HCM \u2192 PositionBudget",
  "source_system": "peoplesoft",
  "module": "HCM - Position Budgeting / Workforce Planning",
  "target_resource": "PositionBudget",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_POSITION_DATA",
      "description": "Position funding fields: POSITION_NBR, FTE, STD_HOURS, DEPTID, FUND_CODE, PROJECT_ID."
    },
    {
      "object": "PS_POS_BUDGET",
      "description": "Position budget: POSITION_NBR, FISCAL_YEAR, BUDGET_AMT, ENCUM_AMT, EXPEND_AMT, AVAILABLE_BAL. Institution-specific \u2014 not all PS implementations use position budgeting."
    },
    {
      "object": "PS_POS_DIST",
      "description": "Position funding distribution (split funding): POSITION_NBR, FUND_CODE, DEPTID, PROJECT_ID, DIST_PCT. One position may have multiple distributions summing to 100%."
    },
    {
      "object": "PS_JOB (incumbent join)",
      "description": "Count incumbents in each position by joining PS_JOB on POSITION_NBR."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "position_ref",
      "source": "PS_POS_BUDGET.POSITION_NBR or PS_POSITION_DATA.POSITION_NBR",
      "transformation": "Resolve to HELIX position_id."
    },
    {
      "helix_attribute": "fiscal_year",
      "source": "PS_POS_BUDGET.FISCAL_YEAR",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "budgeted_amount",
      "source": "PS_POS_BUDGET.BUDGET_AMT",
      "transformation": "Funded amount."
    },
    {
      "helix_attribute": "actual_spend",
      "source": "PS_POS_BUDGET.EXPEND_AMT or derived from payroll actuals",
      "transformation": "Actual compensation + benefits cost."
    },
    {
      "helix_attribute": "variance",
      "source": "Derived: BUDGET_AMT - EXPEND_AMT",
      "transformation": "Positive = underspent."
    },
    {
      "helix_attribute": "funding_splits",
      "source": "PS_POS_DIST (all rows for this position)",
      "transformation": "Array: {fund_code, deptid, project_id, dist_pct}."
    },
    {
      "helix_attribute": "primary_fund",
      "source": "PS_POS_DIST where DIST_PCT is highest \u2192 FUND_CODE",
      "transformation": "Map to HELIX fund code."
    },
    {
      "helix_attribute": "primary_cost_center",
      "source": "PS_POS_DIST where DIST_PCT is highest \u2192 DEPTID",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "department",
      "source": "PS_POSITION_DATA.DEPTID",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "org_headcount_budget",
      "source": "Count of active positions in DEPTID from PS_POSITION_DATA",
      "transformation": "Planned headcount."
    },
    {
      "helix_attribute": "org_headcount_actual",
      "source": "Count of filled positions (PS_JOB match) in DEPTID",
      "transformation": "Current filled headcount."
    },
    {
      "helix_attribute": "org_headcount_open",
      "source": "org_headcount_budget - org_headcount_actual",
      "transformation": "Unfilled positions."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}