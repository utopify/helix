{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft HCM \u2192 AbsenceRecord",
  "source_system": "peoplesoft",
  "module": "HCM - Absence Management / FMLA",
  "target_resource": "AbsenceRecord",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_GP_ABS_EVENT",
      "description": "Absence event: EMPLID, ABS_TYPE_OPTN (absence type), BGN_DT, END_DT, DURATION_ABS (hours or days), ABS_STATUS."
    },
    {
      "object": "PS_LEAVE_PLAN",
      "description": "Leave plan enrollment: EMPLID, PLAN_TYPE, BENEFIT_PLAN, SERVICE_DT."
    },
    {
      "object": "PS_LEAVE_ACCRUAL",
      "description": "Leave balances: EMPLID, PLAN_TYPE, HRS_EARNED_YTD, HRS_TAKEN_YTD, HRS_ADJUST_YTD, HRS_CARRY_OVER, HRS_BOUGHT, HRS_SOLD."
    },
    {
      "object": "PS_JOB (LOA rows)",
      "description": "Leave of absence action rows: EMPLID, EFFDT, ACTION='LOA', ACTION_REASON, EXPECTED_RETURN_DT."
    },
    {
      "object": "PS_FMLA_LV_APPRVD",
      "description": "FMLA approved leave: EMPLID, FMLA_REQUEST_ID, FMLA_LV_REASON, FMLA_LV_APPROVED, HRS_APPROVED."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "employee_ref",
      "source": "PS_GP_ABS_EVENT.EMPLID",
      "transformation": "Resolve to HELIX employee_id."
    },
    {
      "helix_attribute": "absence_type",
      "source": "PS_GP_ABS_EVENT.ABS_TYPE_OPTN \u2192 decode",
      "transformation": "Map: 'VAC' \u2192 'vacation', 'SCK' \u2192 'sick', 'PER' \u2192 'personal', 'FMLA' \u2192 'fmla', 'SAB' \u2192 'sabbatical', 'BER' \u2192 'bereavement', 'JUR' \u2192 'jury_duty', 'MIL' \u2192 'military', 'PAR' \u2192 'parental', 'WC' \u2192 'workers_comp'."
    },
    {
      "helix_attribute": "start_date",
      "source": "PS_GP_ABS_EVENT.BGN_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "end_date",
      "source": "PS_GP_ABS_EVENT.END_DT",
      "transformation": "Cast to ISO 8601."
    },
    {
      "helix_attribute": "hours_requested",
      "source": "PS_GP_ABS_EVENT.DURATION_ABS",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "fmla_qualifying",
      "source": "PS_FMLA_LV_APPRVD.FMLA_LV_APPROVED = 'Y'",
      "transformation": "Boolean."
    },
    {
      "helix_attribute": "fmla_hours_used",
      "source": "PS_FMLA_LV_APPRVD.HRS_APPROVED (running total)",
      "transformation": "FMLA hours used in the measurement period."
    },
    {
      "helix_attribute": "status",
      "source": "PS_GP_ABS_EVENT.ABS_STATUS",
      "transformation": "Map: 'R' \u2192 'requested', 'A' \u2192 'approved', 'D' \u2192 'denied', 'C' \u2192 'canceled'."
    },
    {
      "helix_attribute": "balance_vacation",
      "source": "PS_LEAVE_ACCRUAL where PLAN_TYPE='vacation': HRS_EARNED - HRS_TAKEN + adjustments",
      "transformation": "Current vacation hours available."
    },
    {
      "helix_attribute": "balance_sick",
      "source": "PS_LEAVE_ACCRUAL where PLAN_TYPE='sick': similar calculation",
      "transformation": "Current sick hours available."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'confidential'"
    }
  ],
  "notes": "PS Absence Management (Global Payroll module) or PS_LEAVE_PLAN (older US absence). FMLA tracking is separate in PS_FMLA_LV_APPRVD. Sabbatical leave (faculty) often tracked via PS_JOB ACTION='LOA' with ACTION_REASON='SAB'. Medical certification stored separately."
}