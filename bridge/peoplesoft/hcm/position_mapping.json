{
  "$schema": "https://helixedu.org/bridge/mapping-schema.json",
  "title": "HELIX Bridge: PeopleSoft HCM \u2192 Position",
  "source_system": "peoplesoft",
  "module": "HCM - Position Management",
  "target_resource": "Position",
  "version": "0.2",
  "source_objects": [
    {
      "object": "PS_POSITION_DATA",
      "description": "Position master: POSITION_NBR, DESCR, JOBCODE, DEPTID, LOCATION, SAL_ADMIN_PLAN, GRADE, REG_TEMP, FULL_PART_TIME, FTE, REPORTS_TO, MAX_HEAD_COUNT, POSN_STATUS (A/I/F), EFFDT."
    },
    {
      "object": "PS_JOBCODE_TBL",
      "description": "Job code table: JOBCODE, DESCR, JOB_FAMILY, JOB_FUNCTION, SAL_ADMIN_PLAN, GRADE, EEO_JOB_GROUP, FLSA_STATUS."
    },
    {
      "object": "PS_SAL_GRADE_TBL",
      "description": "Salary grade: SAL_ADMIN_PLAN, GRADE, MIN_RT_ANNUAL, MID_RT_ANNUAL, MAX_RT_ANNUAL."
    },
    {
      "object": "PS_DEPT_TBL",
      "description": "Department: DEPTID, DESCR, MANAGER_ID."
    },
    {
      "object": "PS_LOCATION_TBL",
      "description": "Work location: LOCATION, DESCR, BUILDING, CAMPUS."
    }
  ],
  "attribute_mappings": [
    {
      "helix_attribute": "position_id",
      "source": "PS_POSITION_DATA.POSITION_NBR",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "position_title",
      "source": "PS_POSITION_DATA.DESCR or PS_JOBCODE_TBL.DESCR",
      "transformation": "Position-specific title if populated, otherwise from job code."
    },
    {
      "helix_attribute": "job_profile",
      "source": "PS_POSITION_DATA.JOBCODE \u2192 PS_JOBCODE_TBL",
      "transformation": "PS JOBCODE = Workday Job Profile. The classification template."
    },
    {
      "helix_attribute": "job_family",
      "source": "PS_JOBCODE_TBL.JOB_FAMILY",
      "transformation": "Grouping of related job codes."
    },
    {
      "helix_attribute": "job_level",
      "source": "PS_JOBCODE_TBL.GRADE or derived from SAL_ADMIN_PLAN + GRADE",
      "transformation": "Map to institutional level structure."
    },
    {
      "helix_attribute": "management_level",
      "source": "PS_JOBCODE_TBL.MANAGER_LEVEL or derived",
      "transformation": "Map: individual contributor, manager, director, VP, executive."
    },
    {
      "helix_attribute": "supervisory_org",
      "source": "PS_POSITION_DATA.DEPTID (PS uses dept as the reporting unit)",
      "transformation": "PS doesn't have supervisory orgs like Workday. DEPTID is the closest equivalent."
    },
    {
      "helix_attribute": "department",
      "source": "PS_POSITION_DATA.DEPTID \u2192 PS_DEPT_TBL.DESCR",
      "transformation": "Map to HELIX org code."
    },
    {
      "helix_attribute": "location",
      "source": "PS_POSITION_DATA.LOCATION \u2192 PS_LOCATION_TBL.DESCR",
      "transformation": "Physical work location."
    },
    {
      "helix_attribute": "compensation_grade",
      "source": "PS_POSITION_DATA.SAL_ADMIN_PLAN + GRADE",
      "transformation": "Composite: salary plan + grade. E.g., 'STF/12'."
    },
    {
      "helix_attribute": "worker_type",
      "source": "PS_POSITION_DATA.REG_TEMP",
      "transformation": "Map: 'R' \u2192 'employee', 'T' \u2192 'contingent'."
    },
    {
      "helix_attribute": "time_type",
      "source": "PS_POSITION_DATA.FULL_PART_TIME",
      "transformation": "Map: 'F' \u2192 'full_time', 'P' \u2192 'part_time'."
    },
    {
      "helix_attribute": "position_status",
      "source": "PS_POSITION_DATA.POSN_STATUS",
      "transformation": "Map: 'A' \u2192 'open' or 'filled' (check incumbent), 'I' \u2192 'closed', 'F' \u2192 'frozen'."
    },
    {
      "helix_attribute": "incumbent_ref",
      "source": "PS_JOB.EMPLID where POSITION_NBR matches (current effective row)",
      "transformation": "Resolve to HELIX employee_id."
    },
    {
      "helix_attribute": "headcount",
      "source": "PS_POSITION_DATA.MAX_HEAD_COUNT",
      "transformation": "Direct map."
    },
    {
      "helix_attribute": "eeo_job_category",
      "source": "PS_JOBCODE_TBL.EEO_JOB_GROUP",
      "transformation": "Map to IPEDS EEO categories."
    },
    {
      "helix_attribute": "fund_code",
      "source": "PS_POSITION_DATA.FUND_CODE or default from DEPTID",
      "transformation": "Map to HELIX fund code."
    },
    {
      "helix_attribute": "meta.source_system",
      "source": "Constant",
      "transformation": "'peoplesoft'"
    },
    {
      "helix_attribute": "meta.classification",
      "source": "Constant",
      "transformation": "'internal'"
    }
  ]
}