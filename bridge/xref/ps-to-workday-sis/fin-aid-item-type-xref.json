{
  "title": "HELIX XREF: Financial Aid Item Types \u2014 PeopleSoft \u2192 HELIX \u2192 Workday",
  "version": "0.1",
  "dimension": "Financial Aid Item Type",
  "description": "Maps PeopleSoft Financial Aid item types (ITEM_TYPE_FA with FIN_AID_TYPE) to helix/award-type and Workday Student financial aid award types and funds. PeopleSoft ITEM_TYPE values are 12-digit, institution-defined codes; ps_code shows the fund they represent. GLBA: award, loan, and ISIR data are GLBA-covered customer information; convert through restricted pipelines only.",
  "columns": [
    "ps_code",
    "ps_description",
    "ps_source",
    "helix_code",
    "helix_terminology",
    "wd_value",
    "wd_description",
    "wd_object",
    "notes"
  ],
  "mappings": [
    {
      "ps_code": "PELL",
      "ps_description": "Federal Pell Grant",
      "ps_source": "ITEM_TYPE_FA.ITEM_TYPE (FIN_AID_TYPE = Grant)",
      "helix_code": "grant",
      "helix_terminology": "helix/award-type",
      "wd_value": "Federal Pell Grant",
      "wd_description": "Federal need-based grant",
      "wd_object": "Financial Aid Award Type / Fund",
      "notes": "VALIDATE: ITEM_TYPE value is local. Pell LEU history comes from NSLDS, not PS."
    },
    {
