{
  "title": "HELIX XREF: Job Code to Job Profile — PeopleSoft → HELIX → Workday",
  "version": "0.1",
  "dimension": "Job Code / Job Profile / Compensation Grade",
  "description": "Structural crosswalk, not an exhaustive value list. PeopleSoft JOBCODE (PS_JOBCODE_TBL) with SAL_ADMIN_PLAN, GRADE, STEP and JOB_FAMILY becomes a Workday Job Profile in a Job Family, with Compensation Grade / Grade Profile / Step. Representative higher-ed rows are shown; faculty rows use helix/faculty-rank, staff rows use helix/worker-type. Rule: one PS job code becomes one Job Profile; SAL_ADMIN_PLAN + GRADE becomes a Compensation Grade (Grade Profile when the range differs by location or union); STEP becomes a Compensation Step.",
  "mappings": [
    {
      "ps_code": "FAC100",
      "ps_description": "Professor",
      "ps_source": "PS_JOBCODE_TBL.JOBCODE + JOB_FAMILY + SAL_ADMIN_PLAN",
      "helix_code": "full_professor",
      "helix_terminology": "helix/faculty-rank",
      "wd_value": "Job Profile: Professor",
      "wd_description": "Faculty, full professor",
      "wd_object": "Job Profile + Job Family (Faculty) + Academic Rank on Academic Appointment",
      "notes": "Rank belongs on the Workday Academic Appointment, not only the job profile. Tenure status (helix/tenure-status: tenured) goes on the appointment track. Example job code values are illustrative."
    },
    {
