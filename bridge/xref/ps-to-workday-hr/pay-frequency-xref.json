{
  "title": "HELIX XREF: Pay Frequency — PeopleSoft → HELIX → Workday",
  "version": "0.1",
  "dimension": "Pay Frequency / Pay Group",
  "description": "Maps PeopleSoft pay frequency (PS_JOB.COMP_FREQUENCY, PAY_CALENDAR frequency) and PAYGROUP to Workday Pay Group and Period Schedule through helix/pay-frequency.",
  "mappings": [
    {
      "ps_code": "W",
      "ps_description": "Weekly",
      "ps_source": "PS_PAYGROUP_TBL / PS_PAY_CALENDAR.PAY_FREQUENCY",
      "helix_code": "weekly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Weekly Pay Group",
      "wd_description": "Weekly period schedule",
      "wd_object": "Pay Group + Period Schedule",
      "notes": ""
    },
    {
      "ps_code": "B",
      "ps_description": "Biweekly",
      "ps_source": "PS_PAYGROUP_TBL / PS_PAY_CALENDAR.PAY_FREQUENCY",
      "helix_code": "biweekly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Biweekly Pay Group",
      "wd_description": "Biweekly period schedule (26 or 27 periods)",
      "wd_object": "Pay Group + Period Schedule",
      "notes": "Plan for 27-pay-period years in the Workday period schedule."
    },
    {
      "ps_code": "S",
      "ps_description": "Semimonthly",
      "ps_source": "PS_PAYGROUP_TBL / PS_PAY_CALENDAR.PAY_FREQUENCY",
      "helix_code": "semimonthly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Semimonthly Pay Group",
      "wd_description": "Semimonthly period schedule",
      "wd_object": "Pay Group + Period Schedule",
      "notes": ""
    },
    {
      "ps_code": "M",
      "ps_description": "Monthly",
      "ps_source": "PS_PAYGROUP_TBL / PS_PAY_CALENDAR.PAY_FREQUENCY",
      "helix_code": "monthly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Monthly Pay Group",
      "wd_description": "Monthly period schedule",
      "wd_object": "Pay Group + Period Schedule",
      "notes": "Typical for exempt staff and faculty."
    },
    {
      "ps_code": "M (9/12)",
      "ps_description": "Monthly, 9-month salary paid over 12",
      "ps_source": "PS_JOB.PAYGROUP + contract pay setup (PS_CONTRACT_DATA / CONTRACT_NUM)",
      "helix_code": "monthly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Monthly Pay Group + Academic Pay Setup",
      "wd_description": "9-over-12 academic pay",
      "wd_object": "Academic Pay Setup / Period Salary + Pay Group",
      "notes": "PS contract pay or deferred pay becomes Workday academic pay (salary earned over 9, paid over 12, with accrual). This is the most error-prone faculty conversion; test summer payouts. VALIDATE: whether the institution uses PS Contract Pay or a custom deferral."
    },
    {
      "ps_code": "M (9/9)",
      "ps_description": "Monthly, 9-month salary paid over 9",
      "ps_source": "PS_JOB.PAYGROUP",
      "helix_code": "monthly",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Monthly Pay Group (Academic Year)",
      "wd_description": "9-month pay, no deferral",
      "wd_object": "Pay Group + Academic Appointment dates",
      "notes": ""
    },
    {
      "ps_code": "A",
      "ps_description": "Annual",
      "ps_source": "PS_JOB.COMP_FREQUENCY",
      "helix_code": "annual",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Annual compensation frequency",
      "wd_description": "Annualized rate",
      "wd_object": "Compensation Plan frequency (Annual)",
      "notes": "COMP_FREQUENCY describes how the rate is expressed, not how often it is paid. Keep them separate in mapping."
    },
    {
      "ps_code": "C",
      "ps_description": "Per Course / Per Credit",
      "ps_source": "PS_JOB.COMP_FREQUENCY or custom",
      "helix_code": "per_course",
      "helix_terminology": "helix/pay-frequency",
      "wd_value": "Period Salary Plan or One-Time Payment per course",
      "wd_description": "Per-course adjunct pay",
      "wd_object": "Period Salary Plan / One-Time Payment",
      "notes": "VALIDATE: PS has no delivered per-course frequency; most institutions use ADDL_PAY or a custom code."
    }
  ]
}